{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattlane66/scaled-interview-data-assistant/schemas/checkpoint.schema.json",
  "title": "Synthesis Checkpoint v1",
  "type": "object",
  "required": [
    "checkpoint_version",
    "generated_at",
    "analysis_unit",
    "computation",
    "source_index",
    "interview_index",
    "episode_index",
    "segment_index",
    "evidence_bank",
    "codebook",
    "evidence_to_code_mappings",
    "a_to_b_links",
    "clusters",
    "alias_map",
    "decision_log",
    "latest_diff_log"
  ],
  "properties": {
    "checkpoint_version": {"type": "string", "pattern": "^1\\."},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_unit": {"enum": ["episode", "interview"]},
    "computation": {"$ref": "#/$defs/computation"},
    "metadata": {"type": "object"},
    "source_index": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "interview_index": {"type": "array", "items": {"$ref": "#/$defs/interview"}},
    "episode_index": {"type": "array", "items": {"$ref": "#/$defs/episode"}},
    "segment_index": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "evidence_bank": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "codebook": {"type": "array", "items": {"$ref": "#/$defs/code"}},
    "evidence_to_code_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/mapping"}
    },
    "a_to_b_links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "clusters": {"type": "array", "items": {"$ref": "#/$defs/cluster"}},
    "alias_map": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
    "decision_log": {"type": "string"},
    "latest_diff_log": {"type": "string"}
  },
  "$defs": {
    "computation": {
      "type": "object",
      "required": ["a_to_b_association", "clustering_method", "cluster_count"],
      "properties": {
        "a_to_b_association": {"type": "string", "minLength": 1},
        "clustering_method": {"type": "string", "minLength": 1},
        "cluster_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["source_id", "source", "coverage"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC[0-9]{2,}$"},
        "source": {"type": "string", "minLength": 1},
        "coverage": {"enum": ["FULL", "PARTIAL", "UNREADABLE", "UNKNOWN"]}
      },
      "additionalProperties": true
    },
    "interview": {
      "type": "object",
      "required": ["interview"],
      "properties": {"interview": {"type": "string", "pattern": "^I[0-9]{2,}$"}},
      "additionalProperties": true
    },
    "episode": {
      "type": "object",
      "required": ["episode", "interview"],
      "properties": {
        "episode": {"type": "string", "pattern": "^D[0-9]{2,}$"},
        "interview": {"type": "string", "pattern": "^I[0-9]{2,}$"}
      },
      "additionalProperties": true
    },
    "segment": {
      "type": "object",
      "required": ["interview", "segment"],
      "properties": {
        "interview": {"type": "string", "pattern": "^I[0-9]{2,}$"},
        "segment": {"type": "string", "pattern": "^S[0-9]{2,}$"}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence",
        "source_id",
        "interview",
        "episode",
        "segment",
        "source",
        "source_location",
        "speaker",
        "evidence_type",
        "verbatim_excerpt"
      ],
      "properties": {
        "evidence": {"type": "string", "pattern": "^E[0-9]{3,}$"},
        "source_id": {"type": "string", "pattern": "^SRC[0-9]{2,}$"},
        "interview": {"type": "string", "pattern": "^I[0-9]{2,}$"},
        "episode": {"type": "string", "pattern": "^D[0-9]{2,}$"},
        "segment": {"type": "string", "pattern": "^S[0-9]{2,}$"},
        "source": {"type": "string", "minLength": 1},
        "source_location": {"type": "string", "minLength": 1},
        "speaker": {"type": "string", "minLength": 1},
        "evidence_type": {
          "enum": [
            "concrete_event_or_behavior",
            "current_state",
            "observation",
            "interpretation",
            "aspiration",
            "generalization",
            "hypothetical",
            "interviewer_statement",
            "unknown"
          ]
        },
        "verbatim_excerpt": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "code": {
      "type": "object",
      "required": ["code", "definition"],
      "properties": {
        "code": {"type": "string", "pattern": "^[AB][0-9]{2,}$"},
        "definition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "mapping": {
      "type": "object",
      "required": ["evidence", "interview", "episode", "a_codes", "b_codes"],
      "properties": {
        "evidence": {"type": "string", "pattern": "^E[0-9]{3,}$"},
        "interview": {"type": "string", "pattern": "^I[0-9]{2,}$"},
        "episode": {"type": "string", "pattern": "^D[0-9]{2,}$"},
        "a_codes": {"type": ["string", "null"]},
        "b_codes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": ["link", "episode", "a_code", "b_code", "basis", "evidence", "rationale"],
      "properties": {
        "link": {"type": "string", "pattern": "^L[0-9]{3,}$"},
        "episode": {"type": "string", "pattern": "^D[0-9]{2,}$"},
        "a_code": {"type": "string", "pattern": "^A[0-9]{2,}$"},
        "b_code": {"type": "string", "pattern": "^B[0-9]{2,}$"},
        "basis": {"enum": ["EXPLICIT", "INFERRED"]},
        "evidence": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^E[0-9]{3,}$"}
            }
          ]
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "cluster": {
      "type": "object",
      "required": ["cluster"],
      "properties": {
        "episode": {"type": "string", "pattern": "^D[0-9]{2,}$"},
        "interview": {"type": "string", "pattern": "^I[0-9]{2,}$"},
        "cluster": {"type": "string", "pattern": "^C[0-9]{2,}$"}
      },
      "oneOf": [{"required": ["episode"]}, {"required": ["interview"]}],
      "additionalProperties": true
    },
    "alias": {
      "type": "object",
      "required": ["alias", "canonical"],
      "properties": {
        "alias": {"type": "string", "pattern": "^[ABC][0-9]{2,}$"},
        "canonical": {"type": "string", "pattern": "^[ABC][0-9]{2,}$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
