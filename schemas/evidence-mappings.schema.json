{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattlane66/scaled-interview-data-assistant/schemas/evidence-mappings.schema.json",
  "title": "Evidence-to-Code Mappings",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["evidence", "interview", "episode", "a_codes", "b_codes"],
    "properties": {
      "evidence": {"type": "string", "pattern": "^E[0-9]{3,}$"},
      "interview": {"type": "string", "pattern": "^I[0-9]{2,}$"},
      "episode": {"type": "string", "pattern": "^D[0-9]{2,}$"},
      "a_codes": {"type": ["string", "null"]},
      "b_codes": {"type": ["string", "null"]}
    },
    "additionalProperties": true
  }
}
