{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattlane66/scaled-interview-data-assistant/schemas/codebook.schema.json",
  "title": "A/B Codebook",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["code", "definition"],
    "properties": {
      "code": {"type": "string", "pattern": "^[AB][0-9]{2,}$"},
      "family": {"enum": ["A", "B"]},
      "definition": {"type": "string", "minLength": 1}
    },
    "additionalProperties": true
  }
}
