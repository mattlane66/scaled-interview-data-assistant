{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model-generated hypothesis response (untrusted)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "model_version",
    "configuration",
    "responses"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "object"
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "mechanism",
          "evidence_refs",
          "objections",
          "next_test"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^E[0-9]{3,}$"
            }
          },
          "objections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_test": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
