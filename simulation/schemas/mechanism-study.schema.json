{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional behavioral mechanism study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "source_checkpoint_sha256",
    "scope",
    "research_question",
    "review",
    "mechanisms"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "study_id": {
      "type": "string",
      "pattern": "^BMST[0-9]{3,}$"
    },
    "source_checkpoint_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cluster_id"
          ],
          "properties": {
            "kind": {
              "const": "CLUSTER"
            },
            "cluster_id": {
              "type": "string",
              "pattern": "^C[0-9]{2,}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "episode_ids"
          ],
          "properties": {
            "kind": {
              "const": "EPISODES"
            },
            "episode_ids": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^D[0-9]{2,}$"
              }
            }
          }
        }
      ]
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_at",
        "approved_checkpoint_sha256",
        "evidence_reviewed",
        "a_to_b_links_reviewed",
        "cluster_interpretation_reviewed",
        "contrasting_cases_reviewed"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_checkpoint_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence_reviewed": {
          "type": "boolean"
        },
        "a_to_b_links_reviewed": {
          "type": "boolean"
        },
        "cluster_interpretation_reviewed": {
          "type": "boolean"
        },
        "contrasting_cases_reviewed": {
          "type": "boolean"
        }
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mechanism_id",
          "condition",
          "hypothesized_relationship",
          "rival_explanation",
          "counterfactual_condition_change",
          "disconfirming_observation",
          "discriminating_human_test",
          "revisit_when",
          "observations"
        ],
        "properties": {
          "mechanism_id": {
            "type": "string",
            "pattern": "^BM[0-9]{2,}$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "hypothesized_relationship": {
            "type": "string",
            "minLength": 1
          },
          "rival_explanation": {
            "type": "string",
            "minLength": 1
          },
          "counterfactual_condition_change": {
            "type": "string",
            "minLength": 1
          },
          "disconfirming_observation": {
            "type": "string",
            "minLength": 1
          },
          "discriminating_human_test": {
            "type": "string",
            "minLength": 1
          },
          "revisit_when": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "episode",
                "stance",
                "evidence_refs",
                "link_refs",
                "interpretation"
              ],
              "properties": {
                "episode": {
                  "type": "string",
                  "pattern": "^D[0-9]{2,}$"
                },
                "stance": {
                  "enum": [
                    "ALIGNS",
                    "COUNTEREXAMPLE",
                    "AMBIGUOUS",
                    "UNASSESSED"
                  ]
                },
                "evidence_refs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^E[0-9]{3,}$"
                  }
                },
                "link_refs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^L[0-9]{3,}$"
                  }
                },
                "interpretation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
