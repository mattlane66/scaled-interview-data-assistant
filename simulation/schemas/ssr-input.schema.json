{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic similarity measurement input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "construct",
    "embedding_model",
    "anchor_version",
    "epsilon",
    "temperature",
    "anchor_sets",
    "response_embeddings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^R[0-9]{3,}$"
    },
    "construct": {
      "type": "string",
      "minLength": 1
    },
    "embedding_model": {
      "type": "string",
      "minLength": 1
    },
    "anchor_version": {
      "type": "string",
      "minLength": 1
    },
    "epsilon": {
      "type": "number",
      "minimum": 0
    },
    "temperature": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "anchor_sets": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "anchors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rating",
                "text",
                "vector"
              ],
              "properties": {
                "rating": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "vector": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "response_embeddings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "text_sha256",
          "vector"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "vector": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
